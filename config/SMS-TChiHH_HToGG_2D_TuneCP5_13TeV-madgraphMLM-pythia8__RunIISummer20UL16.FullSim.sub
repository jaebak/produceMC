# Testing small (Takes 1.5 hours)
executable = produce_mc_RunIISummer20UL16.SUS.seed.sh
RND_SEED = $(Process) + 0
arguments = $INT(RND_SEED) 200 SMS-TChiHH_HToGG_2D_TuneCP5_13TeV-madgraphMLM-pythia8__RunIISummer20UL16.FullSim.env
queue 1

